{
  "$schema": "https://raw.githubusercontent.com/OleWunschmann/AL-Go/enhance-customALGoFiles-feature/Actions/.Modules/settings.schema.json",
  "type": "PTE",
  "templateUrl": "https://github.com/OleWunschmann/AL-Go@enhance-customALGoFiles-feature",
  "templateSha": "ea2688ea21b5a7d1c209a12ba2cd8366ccdd82fe",
  "customALGoFiles": {
    "filesToInclude": [
      {
        "filter": "CustomTemplateFile.Default.txt"
      },
      {
        "sourceFolder": "TemplateScripts",
        "filter": "source.ps1",
        "destinationFolder": ".github/custom",
        "destinationName": "renamed.ps1"
      },
      {
        "sourceFolder": "TemplateScripts",
        "filter": "glob-*.ps1",
        "destinationFolder": ".github/glob"
      }
    ],
    "filesToExclude": [
      {
        "sourceFolder": ".github/workflows",
        "filter": "DeployReferenceDocumentation.yaml"
      },
      {
        "sourceFolder": "TemplateScripts",
        "filter": "glob-excluded.ps1"
      }
    ]
  }
}
